# ═══════════════════════════════════════════════
# TimeForest 生产环境变量模板
# 复制为 .env 并填入真实值（.env 不会被提交到 Git）
# ═══════════════════════════════════════════════

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# MySQL 连接信息（1Panel 安装的 MySQL）
# 如果在同一台服务器上，默认 host.docker.internal 即可
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=timeforest
DB_USER=root
DB_PASSWORD=your-mysql-password

# Redis 连接信息（1Panel 安装的 Redis）
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 签名密钥（必填，需 >= 32 字符，请替换为随机字符串）
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long